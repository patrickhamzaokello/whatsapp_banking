<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GTBank Social Banking</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
</head>
<body class="bg-gradient-to-br from-orange-50 to-yellow-50 min-h-screen">
    <div class="container mx-auto px-4 py-12">
        <!-- Header Section -->
        <header class="text-center mb-16">
            <div class="mb-8">
                <img src="/images/gtbank_logo.png" alt="GTBank Logo" class="h-16 mx-auto mb-6">
                <h1 class="text-6xl font-black text-orange-600 mb-4 animate__animated animate__fadeIn">
                    GT Social Banking
                </h1>
                <p class="text-2xl font-bold text-gray-600">Secure • Fast • Reliable</p>
            </div>
        </header>

        <!-- Main Content -->
        <main class="max-w-4xl mx-auto">
            <!-- Services Grid -->
            <div class="grid md:grid-cols-2 gap-8 mb-16">
                <!-- Card 1 -->
                <div class="bg-white rounded-2xl shadow-lg p-8 transform hover:scale-105 transition-transform">
                    <h2 class="text-3xl font-bold text-gray-800 mb-4">Merchant Payments</h2>
                    <p class="text-gray-600 mb-6 font-medium">Process secure payments for your business with our advanced merchant solutions.</p>
                    <div class="text-orange-500 font-bold">&rarr;</div>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-2xl shadow-lg p-8 transform hover:scale-105 transition-transform">
                    <h2 class="text-3xl font-bold text-gray-800 mb-4">Bill Payments</h2>
                    <p class="text-gray-600 mb-6 font-medium">Pay your bills quickly and securely through our platform.</p>
                    <div class="text-orange-500 font-bold">&rarr;</div>
                </div>
            </div>

            <!-- Features Section -->
            <div class="bg-white rounded-2xl shadow-lg p-8 mb-16">
                <h2 class="text-4xl font-bold text-center text-gray-800 mb-8">WHY CHOOSE US</h2>
                <div class="grid md:grid-cols-3 gap-8">
                    <div class="text-center">
                        <div class="text-5xl font-bold text-orange-500 mb-4">24/7</div>
                        <p class="font-bold text-gray-700">Always Available</p>
                    </div>
                    <div class="text-center">
                        <div class="text-5xl font-bold text-orange-500 mb-4">100%</div>
                        <p class="font-bold text-gray-700">Secure Transactions</p>
                    </div>
                    <div class="text-center">
                        <div class="text-5xl font-bold text-orange-500 mb-4">0.01s</div>
                        <p class="font-bold text-gray-700">Processing Time</p>
                    </div>
                </div>
            </div>

            <!-- Contact Section -->
            <div class="text-center">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">Need Help?</h2>
                <p class="text-xl font-medium text-gray-600 mb-6">Our support team is here to assist you</p>
                <a href="/support" class="inline-block bg-orange-500 text-white px-8 py-3 rounded-lg hover:bg-orange-600 transition-colors font-bold text-lg">
                    Contact Support
                </a>
            </div>
        </main>
    </div>
</body>
</html>