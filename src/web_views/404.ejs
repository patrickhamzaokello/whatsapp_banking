<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 h-screen flex items-center justify-center p-4">
    <div class="max-w-lg w-full text-center">
        <div class="bg-white rounded-lg shadow-lg p-8">
            <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="text-red-500 text-5xl font-bold">404</span>
            </div>
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Page Not Found</h1>
            <p class="text-gray-600 mb-8">The page you're looking for doesn't exist or has been moved.</p>
            <div class="bg-red-50 rounded-lg p-4 mb-6">
                <p class="text-red-800">
                    Error Code: 404
                    <span class="block mt-2 text-sm">Path not found on server</span>
                </p>
            </div>
            <a href="/" class="inline-block bg-red-500 text-white px-8 py-3 rounded-lg hover:bg-red-600 transition-colors font-medium">
                Return Home
            </a>
        </div>
    </div>
</body>
</html>